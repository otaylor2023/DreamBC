# Vendored Ctrl-World assets: do not re-add upstream demo media or model weights.
# (Existing files committed in history are not removed by this rule; run
# `git rm -r --cached Ctrl-World/synthetic_traj/ Ctrl-World/checkpoint/ Ctrl-World/dataset/`
# to drop them from tracking if desired.)
Ctrl-World/synthetic_traj/
Ctrl-World/checkpoint/
Ctrl-World/dataset/
