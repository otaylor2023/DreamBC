FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
RUN pip install --no-cache-dir runpod google-cloud-storage

COPY cosmos_transfer/spec.py cosmos_transfer/gcs.py /app/
COPY cosmos_transfer/runpod/handler_stub.py /app/handler.py

ENV GCS_BUCKET=dreambc_videos
ENV GCS_PREFIX=cosmos-transfer

CMD ["python", "-u", "/app/handler.py"]
